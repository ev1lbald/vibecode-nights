# Website server
PORT=3000
DATA_DIR=./data
# Unset to run the explicit agent stub. Configure only on the server.
AGENT_API_URL=
AGENT_API_TOKEN=
# Set to 1 behind the HTTPS reverse proxy in production.
COOKIE_SECURE=0
TRUST_PROXY=0

# Agent API (optional; not started by the website)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=your-model
# LLM_API_KEY=
# LLM_JSON_MODE=false
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=90
# LLM_ATTEMPTS=3
# GRAPH_MAX_CONCURRENCY=4
# SESSION_DB=data/pitch.sqlite3
# API_BEARER_TOKEN=
# PITCH_CONFIG=pitch.toml
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
